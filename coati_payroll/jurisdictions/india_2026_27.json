  "rules": {
    "epf_employee": {
      "code": "IN-EPF-EMPLOYEE-2026",
      "type": "deduction",
      "before_tax": true,
      "employee_rate": "0.12",
      "formula": {
        "inputs": [
          {"name": "salario_bruto", "type": "decimal", "default": 0},
          {"name": "employee_rate", "type": "decimal", "default": "0.12"}
