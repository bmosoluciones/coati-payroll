    "income_tax": {
      "code": "IN-TDS-115BAC-AY26-27",
      "type": "tax",
      "before_tax": false,
      "tax_tables": {
        "annual_slabs": [
          {"min": 0, "max": 400000, "rate": 0, "fixed": 0, "over": 0},
          {"min": 400000.01, "max": 800000, "rate": 0.05, "fixed": 0, "over": 400000},
          {"min": 800000.01, "max": 1200000, "rate": 0.10, "fixed": 20000, "over": 800000},
          {"min": 1200000.01, "max": 1600000, "rate": 0.15, "fixed": 60000, "over": 1200000},
          {"min": 1600000.01, "max": 2000000, "rate": 0.20, "fixed": 120000, "over": 1600000},
          {"min": 2000000.01, "max": 2400000, "rate": 0.25, "fixed": 200000, "over": 2000000},
          {"min": 2400000.01, "max": null, "rate": 0.30, "fixed": 300000, "over": 2400000}
        ]
      },
      "formula": {
        "inputs": [
          {"name": "salario_bruto", "type": "decimal", "default": 0},
          {"name": "pre_tax_deductions", "type": "decimal", "default": 0},
          {"name": "meses_restantes", "type": "decimal", "default": 12},
          {"name": "salario_neto_acumulado", "type": "decimal", "default": 0},
          {"name": "ir_retenido_acumulado", "type": "decimal", "default": 0}
        ],
        "steps": [
          {"name": "annual_taxable_income", "type": "calculation", "formula": "(salario_bruto - pre_tax_deductions) * meses_restantes + salario_neto_acumulado"},
          {"name": "annual_tax", "type": "tax_lookup", "table": "annual_slabs", "input": "annual_taxable_income"},
          {"name": "monthly_tax", "type": "calculation", "formula": "(annual_tax - ir_retenido_acumulado) / meses_restantes"}
        ],
        "tax_tables": {
          "annual_slabs": [
            {"min": 0, "max": 400000, "rate": 0, "fixed": 0, "over": 0},
            {"min": 400000.01, "max": 800000, "rate": 0.05, "fixed": 0, "over": 400000},
            {"min": 800000.01, "max": 1200000, "rate": 0.10, "fixed": 20000, "over": 800000},
            {"min": 1200000.01, "max": 1600000, "rate": 0.15, "fixed": 60000, "over": 1200000},
            {"min": 1600000.01, "max": 2000000, "rate": 0.20, "fixed": 120000, "over": 1600000},
